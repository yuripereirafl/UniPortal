# ================================
# CONFIGURAÇÕES DO UNIPORTAL
# ================================
# Copie este arquivo para .env e ajuste as configurações conforme necessário

# Ambiente de execução (development, production, testing)
ENVIRONMENT=development

# ================================
# CONFIGURAÇÕES DE REDE
# ================================
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ================================
# CONFIGURAÇÕES DO BANCO DE DADOS  
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=dadosrh
DB_PASSWORD=dadosrh
DB_NAME=dadosrh

# ================================
# URLs DA API
# ================================
# Serão configuradas automaticamente por ambiente
# Sobrescreva apenas se necessário
# API_URL=http://localhost:8000
# VUE_APP_API_URL=http://localhost:8000

# ================================
# SEGURANÇA
# ================================
SECRET_KEY=supersecretkey-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ================================
# CONFIGURAÇÕES DOCKER
# ================================
COMPOSE_PROJECT_NAME=uniportal-main-fresh

# ================================
# AMBIENTES ESPECÍFICOS
# ================================

# Para DESENVOLVIMENTO LOCAL:
# ENVIRONMENT=development
# DB_HOST=localhost
# API_URL=http://localhost:8000

# Para PRODUÇÃO:
# ENVIRONMENT=production  
# DB_HOST=154.12.231.86
# API_URL=http://192.168.1.37:8000
# SECRET_KEY=your-super-secret-production-key

# Para TESTES:
# ENVIRONMENT=testing
# DB_HOST=localhost
# DB_NAME=dadosrh_test